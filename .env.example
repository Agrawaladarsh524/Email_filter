# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# --- Gmail ----------------------------------------------------------------
# credentials.json comes from a Google Cloud "Desktop app" OAuth client.
# token.json is written on first run after you complete the browser consent.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GMAIL_QUERY=is:unread newer_than:1d

# --- Slack ----------------------------------------------------------------
# Incoming Webhook URL: api.slack.com/apps -> your app -> Incoming Webhooks
SLACK_WEBHOOK_URL=

# --- Telegram -------------------------------------------------------------
# Token from @BotFather. For the chat ID: message your bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Poller ---------------------------------------------------------------
POLL_INTERVAL_SECONDS=300
MAX_MESSAGES_PER_POLL=25
DRY_RUN=false
